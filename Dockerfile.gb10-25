# Nemotron LoRA training image for NVIDIA GB10 / DGX Spark style systems.
# Base image: NVIDIA optimized PyTorch container with Blackwell support.
# NVIDIA notes Blackwell optimization from 25.01 onward, and Nemotron 3 Nano
# HF examples are tested with Transformers 4.57.3.

FROM --platform=linux/arm64 nvcr.io/nvidia/pytorch:25.12-py3

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/workspace/.cache/huggingface \
    HUGGINGFACE_HUB_CACHE=/workspace/.cache/huggingface \
    TOKENIZERS_PARALLELISM=false \
    BASE_MODEL_ID=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16 \
    ADAPTER_OUTPUT_DIR=/workspace/output/adapter \
    SUBMISSION_DIR=/workspace/output/submission \
    PYTHONPATH=/workspace/bitsandbytes

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    git git-lfs wget curl vim nano build-essential cmake pkg-config unzip zip \
 && rm -rf /var/lib/apt/lists/*

RUN git lfs install
RUN python -m pip install --upgrade pip setuptools wheel packaging
RUN python -m pip uninstall -y apex || true

RUN pip install \
    "transformers==4.57.3" \
    "datasets==3.2.0" \
    "accelerate==1.3.0" \
    "peft==0.14.0" \
    "trl==0.15.2" \
    "torchao==0.16.0" \
    "huggingface_hub==0.36.2" \
    "sentencepiece" \
    "safetensors" \
    "scipy" \
    "evaluate" \
    "scikit-learn" \
    "pydantic" \
    "pandas" \
    "tqdm" \
    "jsonschema" \
    "dspy-ai>=2.4.0" \
    "fastapi" \
    "uvicorn[standard]" \
    "pyyaml" \
    "gradio" \
    "neo4j"

# causal-conv1d: build from patched source because:
#   - 1.6.x references TensorImpl::decref_pyobject() absent from NVIDIA's nv25.12 torch ABI
#   - 1.5.x setup.py hardcodes old arches (sm_53/62/70/72) dropped by CUDA 13.0
# Fix: clone 1.5.0.post8, patch setup.py to sm_80/sm_90/sm_120, then build.
#
# mamba-ssm: selective_scan_cuda.so ships as x86_64 in the base image's dist-packages.
# Python silently ignores it on aarch64 (platform tag mismatch). The source build
# silently skips compiling the extension. Patch selective_scan_interface.py with
# try/except so the package imports cleanly; Mamba-2 ops use Triton and never call
# the legacy CUDA path.
#
# Pass --build-arg MAMBA_REBUILD=$(date +%s) to force recompile on arch change.
ARG MAMBA_REBUILD=1
RUN cd /tmp \
 && git clone --depth 1 --branch v1.5.0.post8 \
      https://github.com/Dao-AILab/causal-conv1d.git cc1d_src \
 && python3 -c "
with open('/tmp/cc1d_src/setup.py') as f:
    lines = f.readlines()
new_lines = (
    lines[:172] +
    [
        '        cc_flag.append(\"-gencode\")\n',
        '        cc_flag.append(\"arch=compute_80,code=sm_80\")\n',
        '        cc_flag.append(\"-gencode\")\n',
        '        cc_flag.append(\"arch=compute_90,code=sm_90\")\n',
        '        if bare_metal_version >= Version(\"12.0\"):\n',
        '            cc_flag.append(\"-gencode\")\n',
        '            cc_flag.append(\"arch=compute_120,code=sm_120\")\n',
    ] +
    lines[187:]
)
with open('/tmp/cc1d_src/setup.py', 'w') as f:
    f.writelines(new_lines)
" \
 && CAUSAL_CONV1D_FORCE_BUILD=TRUE CUDA_HOME=/usr/local/cuda \
    pip install /tmp/cc1d_src --no-deps --no-build-isolation \
 && rm -rf /tmp/cc1d_src

RUN TORCH_CUDA_ARCH_LIST="8.0;8.6;8.7;8.9;9.0;12.0;12.1+PTX" \
    CUDA_HOME=/usr/local/cuda \
    MAX_JOBS=8 \
    pip install mamba-ssm --no-binary mamba-ssm --no-build-isolation \
 && python3 -c "f='/usr/local/lib/python3.12/dist-packages/mamba_ssm/ops/selective_scan_interface.py'; c=open(f).read(); needle='\nimport selective_scan_cuda\n'; open(f,'w').write(c.replace(needle,'\ntry:\n    import selective_scan_cuda\nexcept ImportError:\n    selective_scan_cuda = None\n',1)) if needle in c else None"

RUN pip install scikit-build-core
RUN git clone https://github.com/bitsandbytes-foundation/bitsandbytes.git /workspace/bitsandbytes \
 && cd /workspace/bitsandbytes \
 && cmake -DCOMPUTE_BACKEND=cuda -DCOMPUTE_CAPABILITY="80;86;87;89;90;120;121" -S . -B build \
 && cmake --build build --config Release -j8 \
 && pip install -e . --no-build-isolation

RUN mkdir -p \
    /workspace/data \
    /workspace/configs \
    /workspace/scripts \
    /workspace/output \
    /workspace/.cache/huggingface

COPY *.py /workspace/
COPY data /workspace/data
COPY configs /workspace/configs
COPY scripts /workspace/scripts

CMD ["/bin/bash"]
